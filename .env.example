# ============================================================
# Diversifying.io — AI Recruitment Tool
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Gemini API ----
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ---- PostgreSQL (Docker) ----
# These match the values in docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dyversifying_db
POSTGRES_USER=dyversifying_user
POSTGRES_PASSWORD=change_me_in_production

# Full connection string (constructed from the above)
DATABASE_URL=postgresql://dyversifying_user:change_me_in_production@localhost:5432/dyversifying_db

# ---- FastAPI ----
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- File Storage ----
UPLOAD_DIR=data/raw
PROCESSED_DIR=data/processed

# ---- AI Model Config ----
# Gemini model for text generation / extraction (current as of August 2026)
GEMINI_MODEL=gemini-3.6-flash
# Gemini embedding model — text-only, production-grade (current as of August 2026)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# ---- App Config ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Frontend / CORS ----
# In development: http://localhost:3000
# In production (Render): set to your Vercel URL, e.g. https://dyversifying.vercel.app
# Multiple origins: comma-separated "https://dyversifying.vercel.app,https://dyversifying.io"
FRONTEND_URL=http://localhost:3000

# ============================================================
# PRODUCTION DEPLOYMENT (Render + Supabase + Vercel)
# ============================================================
#
# 1. SUPABASE DATABASE
#    - Create a free project at https://supabase.com
#    - Go to Project Settings → Database → Connection string (URI mode)
#    - Replace DATABASE_URL above with the Supabase URI:
#      postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#    - Run db/schema.sql in Supabase SQL Editor to create all tables
#
# 2. RENDER BACKEND
#    - Push this repo to GitHub
#    - Go to https://dashboard.render.com → New → Blueprint
#    - Connect your repo — Render reads render.yaml automatically
#    - Set all secret env vars in Render Dashboard → Environment:
#        GEMINI_API_KEY, DATABASE_URL, SECRET_KEY, FRONTEND_URL
#
# 3. VERCEL FRONTEND
#    - Go to https://vercel.com → Add New Project → Import Git Repository
#    - Set Root Directory to "frontend"
#    - Add environment variable: NEXT_PUBLIC_API_URL=https://dyversifying-api.onrender.com
#
# 4. UPTIME ROBOT (Keep-alive for Render free tier)
#    - Go to https://uptimerobot.com → Add New Monitor
#    - Type: HTTP(s), URL: https://dyversifying-api.onrender.com/api/v1/health
#    - Interval: 14 minutes (keeps Render from sleeping)
